# Copiez ce fichier en .env (à côté de docker-compose.yml) et remplissez-le.

# Nom d'hôte EXACT tapé dans le navigateur (sans http:// ni chemin) :
# Traefik route sur ce nom, et l'application refuse les autres.
JOBSCOUT_HOST=jobscout.xperiment

# Autres noms acceptés, séparés par des virgules (ex. le nom Tailscale de la machine
# si vous passez par `tailscale serve`, voir DEPLOY-HOMELAB.md).
JOBSCOUT_EXTRA_HOSTS=

# Port ouvert sur 127.0.0.1 seulement (cible de `tailscale serve`).
JOBSCOUT_LOCAL_PORT=3000

# Mot de passe de connexion à JobScout.
JOBSCOUT_PASSWORD=

# Heure du scan automatique quotidien (HH:MM, fuseau TZ). Vide = désactivé.
JOBSCOUT_DAILY_SCAN=06:30
TZ=Europe/Paris

# Réseau Docker partagé avec Traefik. JobScout répond en http:// et en https://.
TRAEFIK_NETWORK=traefik-public

# 0 = image sans le moteur LinkedIn (plus légère).
WITH_LINKEDIN=1

# France Travail — API officielle (optionnel, plus fiable que les pages publiques).
# FT_CLIENT_ID=
# FT_CLIENT_SECRET=
